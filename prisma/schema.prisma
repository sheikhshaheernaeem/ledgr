generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String?
  role      String   @default("CLIENT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts          Account[]
  sessions          Session[]
  transactions      Transaction[]
  reports           Report[]
  subscription      Subscription?
  bankAccounts      BankAccount[]
  invoices          Invoice[]
  budgets           Budget[]
  messages          Message[]
  auditLogs         AuditLog[]
  plaidConnections  PlaidConnection[]
  cashFlowForecasts CashFlowForecast[]
  paymentLink       String?
  customCategories  String?
  clients           Client[]
  companyName       String?
  companyAddress    String?
  companyLogo       String?
  revenueGoal       Float?
  documents         Document[]
  vatNumber         String?

  chartOfAccounts      ChartOfAccount[]
  journalEntries       JournalEntry[]
  bills                Bill[]
  lockedPeriods        LockedPeriod[]
  fixedAssets          FixedAsset[]
  payrollRuns          PayrollRun[]
  timeEntries          TimeEntry[]
  workpapers           Workpaper[]
  vatReturns           VatReturn[]
  managedClients       ManagedClient[]      @relation("accountant")
  managedByAccounts    ManagedClient[]      @relation("client")
  emailVerified        Boolean              @default(false)
  emailVerifications   EmailVerification[]
  passwordResetTokens  PasswordResetToken[]

  // 2FA
  twoFactorSecret      String?
  twoFactorEnabled     Boolean @default(false)
  twoFactorBackupCodes String?

  // Invoice branding
  invoiceBrandColor String?
  invoiceFooterText String?

  // Notification preferences (JSON)
  notificationPrefs String?

  // Regional / locale settings
  country        String  @default("US")
  currency       String  @default("USD")
  locale         String  @default("en-US")
  timezone       String  @default("America/New_York")
  taxName        String  @default("Tax")
  defaultTaxRate Float   @default(0)

  // Firm white-label (JSON)
  firmBranding String?

  // Stripe billing
  stripeCustomerId    String?
  subscriptionStatus  String?

  // New feature relations
  expenseClaims       ExpenseClaim[]
  mileageEntries      MileageEntry[]
  categorizationRules CategorizationRule[]
  taxCalendarEvents   TaxCalendarEvent[]
  openingBalances     OpeningBalance[]
  apiKeys             ApiKey[]
  webhooks            Webhook[]
  notifications       Notification[]
  transactionComments TransactionComment[]
  teamMembersOwned    TeamMember[]         @relation("TeamOwner")
  teamMemberOf        TeamMember[]         @relation("TeamMember")

  // Enterprise relations
  entities             Entity[]
  departments          Department[]
  projects             Project[]
  inventoryItems       InventoryItem[]
  approvalWorkflows    ApprovalWorkflow[]
  approvalRequests     ApprovalRequest[]
  revenueContracts     RevenueContract[]
  leaseContracts       LeaseContract[]
  deferredTaxItems     DeferredTaxItem[]
  customReports        CustomReport[]
  financialSnapshots   FinancialSnapshot[]
  sodRules             SodRule[]
  integrationConfigs   IntegrationConfig[]
  vendorPortalInvites  VendorPortalInvite[]
  anomalyFlags         AnomalyFlag[]
  vendors              Vendor[]
  cashFlowScenarios    CashFlowScenario[]
  whiteLabelConfig     WhiteLabelConfig?
  statements           Statement[]
}

model EmailVerification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Transaction {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date             DateTime
  description      String
  amount           Float
  type             String
  category         String?
  subcategory      String?
  confidence       Float?
  status           String   @default("PENDING")
  aiNotes          String?
  reportId         String?
  report           Report?  @relation(fields: [reportId], references: [id])
  createdAt        DateTime @default(now())

  bankAccountId    String?
  bankAccount      BankAccount? @relation(fields: [bankAccountId], references: [id])
  receiptData      String?
  receiptOcrRaw    String?
  taxCategory      String?
  taxLine          String?
  isRecurring      Boolean  @default(false)
  recurringGroupId String?
  reconciled       Boolean  @default(false)
  reconciledAt     DateTime?
  bankStatementRef String?
  invoiceId        String?
  invoice          Invoice? @relation(fields: [invoiceId], references: [id])
  notes            String?

  // Duplicate detection
  duplicateOfId String?

  // FX / multi-currency
  exchangeRate        Float?
  baseCurrencyAmount  Float?

  // Import tracking
  importId    String?
  source      String?
  voucherType String?
  accountId   String?

  messages            Message[]
  auditLogs           AuditLog[]
  reconciliationItems ReconciliationItem[]
  comments            TransactionComment[]

  // Enterprise fields
  entityId    String?
  departmentId String?
  projectId    String?
}

model Report {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  month         Int
  year          Int
  status        String        @default("DRAFT")
  totalIncome   Float         @default(0)
  totalExpenses Float         @default(0)
  netProfit     Float         @default(0)
  aiSummary     String?
  sentAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  transactions  Transaction[]
  messages      Message[]
  workpapers    Workpaper[]

  clientApprovalToken String?  @unique
  clientApprovedAt    DateTime?
  clientEmail         String?

  // Two-stage approval: AI drafts → accountant reviews → client approves
  draftedAt              DateTime?
  accountantApprovedAt   DateTime?
  accountantApprovedById String?
  revisionNotes          String?
}

model Subscription {
  id        String    @id @default(cuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      String    @default("STARTER")
  status    String    @default("ACTIVE")
  stripeId  String?
  startedAt DateTime  @default(now())
  expiresAt DateTime?
}

model BankAccount {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  accountType     String   @default("CHECKING")
  institutionName String?
  lastFourDigits  String?
  currency        String   @default("USD")
  currentBalance  Float    @default(0)
  isPlaidLinked   Boolean  @default(false)
  plaidAccountId  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  transactions      Transaction[]
  reconciliations   Reconciliation[]
  fundTransfersFrom FundTransfer[] @relation("FundTransferFrom")
  fundTransfersTo   FundTransfer[] @relation("FundTransferTo")
}

model Reconciliation {
  id               String   @id @default(cuid())
  bankAccountId    String
  bankAccount      BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  userId           String
  statementDate    DateTime
  statementBalance Float
  status           String   @default("IN_PROGRESS")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  items ReconciliationItem[]
}

model ReconciliationItem {
  id               String         @id @default(cuid())
  reconciliationId String
  reconciliation   Reconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  transactionId    String?
  transaction      Transaction?   @relation(fields: [transactionId], references: [id])
  statementDate    DateTime
  statementDesc    String
  statementAmount  Float
  matched          Boolean  @default(false)
  matchedAt        DateTime?
  createdAt        DateTime @default(now())
}

model Invoice {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoiceNumber String
  clientName    String
  clientEmail   String?
  clientVatNumber String?
  issueDate     DateTime
  dueDate       DateTime
  status        String   @default("DRAFT")
  subtotal      Float
  taxRate       Float    @default(0)
  taxAmount     Float    @default(0)
  total         Float
  notes         String?
  paidAt        DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  lineItems    InvoiceLineItem[]
  transactions Transaction[]

  clientId          String?
  client            Client?  @relation(fields: [clientId], references: [id])
  isRecurring       Boolean  @default(false)
  recurringInterval String?
  nextInvoiceDate   DateTime?
  publicToken       String?   @unique
  amountPaid        Float     @default(0)
  type              String   @default("INVOICE")
  currency          String   @default("USD")
  lateFeePct        Float    @default(0)
  timeEntries       TimeEntry[]

  // Discount
  discountAmount Float @default(0)

  // Multi-jurisdiction tax (JSON array of {label, rate, amount})
  taxLines String?

  // FX
  exchangeRate       Float?
  baseCurrencyAmount Float?

  // Enterprise fields
  entityId String?

  // Credit note / estimate links (self-relation)
  relatedInvoiceId String?
  relatedInvoice   Invoice?  @relation("InvoiceRelation", fields: [relatedInvoiceId], references: [id])
  relatedDocuments Invoice[] @relation("InvoiceRelation")

  poNumber String?

  // Partial payments
  payments InvoicePayment[]

  @@unique([userId, invoiceNumber])
}

model InvoicePayment {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  userId      String
  amount      Float
  paymentDate DateTime
  method      String   @default("OTHER")
  reference   String?
  notes       String?
  createdAt   DateTime @default(now())

  @@index([invoiceId])
  @@index([userId])
}

model Client {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  phone     String?
  company   String?
  address   String?
  notes     String?
  vatNumber String?
  taxId     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  invoices  Invoice[]
  documents Document[]
  timeEntries TimeEntry[]
  projects  Project[]
  revenueContracts RevenueContract[]

  @@index([userId])
}

model InvoiceLineItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Float   @default(1)
  unitPrice   Float
  amount      Float
  discount    Float   @default(0)
  createdAt   DateTime @default(now())
}

model Budget {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month     Int
  year      Int
  category  String
  amount    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, year, month, category])
}

model Message {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id])
  reportId      String?
  report        Report?      @relation(fields: [reportId], references: [id])
  body          String
  role          String       @default("CLIENT")
  readAt        DateTime?
  createdAt     DateTime     @default(now())
}

model AuditLog {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  action        String
  entityType    String
  entityId      String
  before        String?
  after         String?
  ipAddress     String?
  createdAt     DateTime     @default(now())
  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id])
}

model PlaidConnection {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  institutionId   String
  institutionName String
  accessToken     String
  itemId          String
  status          String    @default("ACTIVE")
  lastSyncAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model CashFlowForecast {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  generatedAt  DateTime @default(now())
  periodStart  DateTime
  periodEnd    DateTime
  forecastJson String
  narrative    String?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Document {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  type        String   @default("OTHER")
  content     String?
  mimeType    String   @default("text/plain")
  clientId    String?
  client      Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  status      String   @default("DRAFT")
  publicToken String?  @unique
  sentAt      DateTime?
  signedAt    DateTime?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([clientId])
}

// ─── Chart of Accounts ────────────────────────────────────────────────────────

model ChartOfAccount {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code          String
  name          String
  type          String   // ASSET | LIABILITY | EQUITY | REVENUE | EXPENSE
  subtype       String?
  description   String?
  parentCode    String?
  normalBalance String   @default("DEBIT")
  isSystem      Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  journalLines  JournalEntryLine[]

  @@unique([userId, code])
  @@index([userId])
}

// ─── Journal Entries ──────────────────────────────────────────────────────────

model JournalEntry {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entryNumber String
  date        DateTime
  description String
  reference   String?
  type        String   @default("MANUAL")
  status      String   @default("POSTED")
  reversalOf  String?
  memo        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Approval workflow
  pendingApproval Boolean   @default(false)
  approvedById    String?
  approvedAt      DateTime?

  // Enterprise fields
  entityId     String?
  departmentId String?

  lines       JournalEntryLine[]

  @@unique([userId, entryNumber])
  @@index([userId])
  @@index([userId, date])
}

model JournalEntryLine {
  id             String         @id @default(cuid())
  journalEntryId String
  journalEntry   JournalEntry   @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        ChartOfAccount @relation(fields: [accountId], references: [id])
  description    String?
  debit          Float          @default(0)
  credit         Float          @default(0)
  createdAt      DateTime       @default(now())

  @@index([journalEntryId])
  @@index([accountId])
}

// ─── Accounts Payable ─────────────────────────────────────────────────────────

model Bill {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  billNumber  String
  vendorName  String
  vendorEmail String?
  vendorId    String?
  vendor      Vendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  issueDate   DateTime
  dueDate     DateTime
  status      String   @default("PENDING")
  subtotal    Float
  taxRate     Float    @default(0)
  taxAmount   Float    @default(0)
  total       Float
  amountPaid  Float    @default(0)
  currency    String   @default("USD")
  notes       String?
  category    String?
  paidAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lineItems   BillLineItem[]

  // Enterprise fields
  entityId String?

  @@unique([userId, billNumber])
  @@index([userId])
}

model BillLineItem {
  id          String   @id @default(cuid())
  billId      String
  bill        Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  description String
  quantity    Float    @default(1)
  unitPrice   Float
  amount      Float
  accountCode String?
  createdAt   DateTime @default(now())
}

// ─── Vendor ───────────────────────────────────────────────────────────────────

model Vendor {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  phone     String?
  company   String?
  address   String?
  taxId     String?
  vatNumber String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bills     Bill[]

  @@index([userId])
}

// ─── Period Locking ───────────────────────────────────────────────────────────

model LockedPeriod {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  year     Int
  month    Int
  lockedAt DateTime @default(now())
  lockedBy String
  notes    String?

  @@unique([userId, year, month])
  @@index([userId])
}

// ─── Fixed Assets ─────────────────────────────────────────────────────────────

model FixedAsset {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  assetNumber        String?
  description        String?
  purchaseDate       DateTime
  purchaseCost       Float
  salvageValue       Float    @default(0)
  usefulLifeMonths   Int
  depreciationMethod String   @default("STRAIGHT_LINE")
  assetAccountCode   String?
  depnAccountCode    String?
  expenseAccountCode String?
  disposalDate       DateTime?
  disposalValue      Float?
  status             String   @default("ACTIVE")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  depreciationEntries DepreciationEntry[]

  @@index([userId])
}

model DepreciationEntry {
  id        String     @id @default(cuid())
  assetId   String
  asset     FixedAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  userId    String
  month     Int
  year      Int
  amount    Float
  bookValue Float
  posted    Boolean    @default(false)
  createdAt DateTime   @default(now())

  @@unique([assetId, year, month])
  @@index([userId])
}

// ─── Payroll ──────────────────────────────────────────────────────────────────

model PayrollRun {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  runNumber   String
  periodStart DateTime
  periodEnd   DateTime
  payDate     DateTime
  totalGross  Float    @default(0)
  totalTax    Float    @default(0)
  totalNet    Float    @default(0)
  status      String   @default("DRAFT")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees   PayrollEmployee[]

  @@index([userId])
}

model PayrollEmployee {
  id              String     @id @default(cuid())
  payrollRunId    String
  payrollRun      PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  userId          String
  employeeName    String
  employeeId      String?
  payType         String     @default("SALARY")
  hoursWorked     Float?
  hourlyRate      Float?
  grossPay        Float
  federalTax      Float      @default(0)
  stateTax        Float      @default(0)
  socialSecurity  Float      @default(0)
  medicare        Float      @default(0)
  otherDeductions Float      @default(0)
  netPay          Float
  is1099          Boolean    @default(false)
  createdAt       DateTime   @default(now())
}

// ─── Time Tracking ────────────────────────────────────────────────────────────

model TimeEntry {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId    String?
  client      Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  date        DateTime
  hours       Float
  description String
  hourlyRate  Float    @default(0)
  amount      Float    @default(0)
  billable    Boolean  @default(true)
  invoiced    Boolean  @default(false)
  invoiceId   String?
  invoice     Invoice? @relation(fields: [invoiceId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([clientId])
}

// ─── Workpapers ───────────────────────────────────────────────────────────────

model Workpaper {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reportId    String?
  report      Report?  @relation(fields: [reportId], references: [id])
  name        String
  description String?
  status      String   @default("IN_PROGRESS")
  assignedTo  String?
  dueDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       WorkpaperItem[]

  @@index([userId])
}

model WorkpaperItem {
  id          String    @id @default(cuid())
  workpaperId String
  workpaper   Workpaper @relation(fields: [workpaperId], references: [id], onDelete: Cascade)
  description String
  reference   String?
  status      String    @default("PENDING")
  notes       String?
  tickedBy    String?
  tickedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ─── VAT Returns ──────────────────────────────────────────────────────────────

model VatReturn {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  periodStart    DateTime
  periodEnd      DateTime
  totalSales     Float    @default(0)
  vatOnSales     Float    @default(0)
  totalPurchases Float    @default(0)
  vatOnPurchases Float    @default(0)
  vatPayable     Float    @default(0)
  status         String   @default("DRAFT")
  filedAt        DateTime?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

// ─── Multi-client Mode ────────────────────────────────────────────────────────

model ManagedClient {
  id           String   @id @default(cuid())
  accountantId String
  accountant   User     @relation("accountant", fields: [accountantId], references: [id], onDelete: Cascade)
  clientId     String
  client       User     @relation("client", fields: [clientId], references: [id], onDelete: Cascade)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@unique([accountantId, clientId])
  @@index([accountantId])
}

// ─── Expense Claims ───────────────────────────────────────────────────────────

model ExpenseClaim {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  claimNumber String
  description String
  status      String   @default("DRAFT")
  submittedAt DateTime?
  approvedAt  DateTime?
  paidAt      DateTime?
  notes       String?
  totalAmount Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       ExpenseClaimItem[]

  @@index([userId])
}

model ExpenseClaimItem {
  id          String       @id @default(cuid())
  claimId     String
  claim       ExpenseClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  date        DateTime
  description String
  category    String?
  amount      Float
  receiptData String?
  createdAt   DateTime     @default(now())

  @@index([claimId])
}

// ─── Mileage Tracker ─────────────────────────────────────────────────────────

model MileageEntry {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime
  description String
  fromAddress String?
  toAddress   String?
  miles       Float
  ratePerMile Float    @default(0.67)
  amount      Float    @default(0)
  purpose     String   @default("BUSINESS")
  clientId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

// ─── Auto Categorization Rules ───────────────────────────────────────────────

model CategorizationRule {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  keyword     String
  matchType   String   @default("CONTAINS")
  category    String
  subcategory String?
  taxCategory String?
  isActive    Boolean  @default(true)
  priority    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

// ─── Tax Calendar ─────────────────────────────────────────────────────────────

model TaxCalendarEvent {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  dueDate     DateTime
  type        String   @default("FILING")
  status      String   @default("UPCOMING")
  amount      Float?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

// ─── Opening Balances ─────────────────────────────────────────────────────────

model OpeningBalance {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountCode String
  accountName String
  accountType String
  debit       Float    @default(0)
  credit      Float    @default(0)
  asOfDate    DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, accountCode])
  @@index([userId])
}

// ─── API Keys ─────────────────────────────────────────────────────────────────

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  keyHash    String    @unique
  prefix     String
  lastUsedAt DateTime?
  expiresAt  DateTime?
  isActive   Boolean   @default(true)
  scopes     String    @default("read")
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// ─── Webhooks ─────────────────────────────────────────────────────────────────

model Webhook {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  url         String
  events      String
  secret      String
  isActive    Boolean   @default(true)
  description String?
  lastPingAt  DateTime?
  failCount   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
}

// ─── In-app Notifications ─────────────────────────────────────────────────────

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([userId, readAt])
}

// ─── Transaction Comments ─────────────────────────────────────────────────────

model TransactionComment {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  body          String
  createdAt     DateTime    @default(now())

  @@index([transactionId])
  @@index([userId])
}

// ─── Team Members ─────────────────────────────────────────────────────────────

model TeamMember {
  id          String   @id @default(cuid())
  ownerId     String
  owner       User     @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  memberId    String
  member      User     @relation("TeamMember", fields: [memberId], references: [id], onDelete: Cascade)
  role        String   @default("VIEWER")
  permissions String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([ownerId, memberId])
  @@index([ownerId])
  @@index([memberId])
}

// ─── Multi-Entity / Subsidiaries ─────────────────────────────────────────────

model Entity {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  code        String
  type        String   @default("SUBSIDIARY")
  parentId    String?
  parent      Entity?  @relation("EntityHierarchy", fields: [parentId], references: [id])
  children    Entity[] @relation("EntityHierarchy")
  currency    String   @default("USD")
  taxId       String?
  address     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  interCompanyFrom InterCompanyTransaction[] @relation("ICFrom")
  interCompanyTo   InterCompanyTransaction[] @relation("ICTo")

  @@unique([userId, code])
  @@index([userId])
}

model InterCompanyTransaction {
  id           String   @id @default(cuid())
  userId       String
  fromEntityId String
  fromEntity   Entity   @relation("ICFrom", fields: [fromEntityId], references: [id])
  toEntityId   String
  toEntity     Entity   @relation("ICTo", fields: [toEntityId], references: [id])
  amount       Float
  currency     String   @default("USD")
  description  String
  date         DateTime
  eliminated   Boolean  @default(false)
  eliminatedAt DateTime?
  createdAt    DateTime @default(now())

  @@index([userId])
}

// ─── Department / Cost Center ─────────────────────────────────────────────────

model Department {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  code        String
  description String?
  managerId   String?
  parentId    String?
  parent      Department?  @relation("DeptHierarchy", fields: [parentId], references: [id])
  children    Department[] @relation("DeptHierarchy")
  budgetJson  String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projects    Project[]

  @@unique([userId, code])
  @@index([userId])
}

// ─── Project / Job Costing ────────────────────────────────────────────────────

model Project {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  code         String
  description  String?
  clientId     String?
  client       Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  status       String     @default("ACTIVE")
  startDate    DateTime?
  endDate      DateTime?
  budget       Float?
  billingType  String     @default("FIXED")
  hourlyRate   Float?
  currency     String     @default("USD")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tasks        ProjectTask[]
  costs        ProjectCost[]

  @@unique([userId, code])
  @@index([userId])
}

model ProjectTask {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String
  name        String
  description String?
  status      String   @default("TODO")
  assignedTo  String?
  estimatedHours Float?
  actualHours    Float?
  dueDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
}

model ProjectCost {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String
  date        DateTime
  description String
  category    String   @default("LABOR")
  amount      Float
  billable    Boolean  @default(true)
  invoiced    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([projectId])
  @@index([userId])
}

// ─── Inventory ────────────────────────────────────────────────────────────────

model InventoryItem {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sku           String
  name          String
  description   String?
  category      String?
  unitOfMeasure String   @default("EACH")
  costMethod    String   @default("FIFO")
  costPrice     Float    @default(0)
  sellPrice     Float    @default(0)
  quantityOnHand Float   @default(0)
  reorderPoint  Float?
  reorderQty    Float?
  assetAccountCode    String?
  cogsAccountCode     String?
  revenueAccountCode  String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  movements     InventoryMovement[]

  @@unique([userId, sku])
  @@index([userId])
}

model InventoryMovement {
  id            String        @id @default(cuid())
  itemId        String
  item          InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId        String
  date          DateTime
  type          String
  quantity      Float
  unitCost      Float
  totalCost     Float
  reference     String?
  notes         String?
  createdAt     DateTime      @default(now())

  @@index([itemId])
  @@index([userId])
}

// ─── Approval Workflows ───────────────────────────────────────────────────────

model ApprovalWorkflow {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  entityType  String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  steps       ApprovalStep[]
  requests    ApprovalRequest[]

  @@index([userId])
}

model ApprovalStep {
  id           String           @id @default(cuid())
  workflowId   String
  workflow     ApprovalWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  stepOrder    Int
  approverRole String
  approverEmail String?
  minAmount    Float?
  maxAmount    Float?
  createdAt    DateTime         @default(now())

  @@index([workflowId])
}

model ApprovalRequest {
  id          String           @id @default(cuid())
  workflowId  String
  workflow    ApprovalWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityType  String
  entityId    String
  currentStep Int              @default(1)
  status      String           @default("PENDING")
  submittedBy String
  amount      Float?
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  actions     ApprovalAction[]

  @@index([userId])
  @@index([entityId])
}

model ApprovalAction {
  id          String          @id @default(cuid())
  requestId   String
  request     ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  step        Int
  action      String
  actorId     String
  actorEmail  String
  notes       String?
  createdAt   DateTime        @default(now())

  @@index([requestId])
}

// ─── Revenue Recognition (ASC 606) ───────────────────────────────────────────

model RevenueContract {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contractNumber  String
  clientId        String?
  client          Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  name            String
  totalValue      Float
  currency        String   @default("USD")
  startDate       DateTime
  endDate         DateTime?
  status          String   @default("ACTIVE")
  recognitionMethod String @default("STRAIGHT_LINE")
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  obligations     PerformanceObligation[]
  schedules       RevenueSchedule[]

  @@unique([userId, contractNumber])
  @@index([userId])
}

model PerformanceObligation {
  id              String          @id @default(cuid())
  contractId      String
  contract        RevenueContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  userId          String
  name            String
  allocatedValue  Float
  satisfiedAt     DateTime?
  status          String          @default("UNSATISFIED")
  notes           String?
  createdAt       DateTime        @default(now())

  @@index([contractId])
}

model RevenueSchedule {
  id              String          @id @default(cuid())
  contractId      String
  contract        RevenueContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  userId          String
  period          DateTime
  scheduledAmount Float
  recognizedAmount Float          @default(0)
  deferredAmount  Float           @default(0)
  posted          Boolean         @default(false)
  createdAt       DateTime        @default(now())

  @@unique([contractId, period])
  @@index([contractId])
}

// ─── Lease Accounting (ASC 842) ───────────────────────────────────────────────

model LeaseContract {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaseNumber     String
  lessorName      String
  assetDescription String
  leaseType       String   @default("OPERATING")
  commencementDate DateTime
  endDate         DateTime
  monthlyPayment  Float
  incrementalBorrowingRate Float @default(0.05)
  rightOfUseAsset Float    @default(0)
  leaseLiability  Float    @default(0)
  remainingLiability Float @default(0)
  status          String   @default("ACTIVE")
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  payments        LeasePayment[]
  amortizationSchedule LeaseAmortization[]

  @@unique([userId, leaseNumber])
  @@index([userId])
}

model LeasePayment {
  id          String        @id @default(cuid())
  leaseId     String
  lease       LeaseContract @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  userId      String
  paymentDate DateTime
  amount      Float
  principal   Float
  interest    Float
  balance     Float
  posted      Boolean       @default(false)
  createdAt   DateTime      @default(now())

  @@index([leaseId])
}

model LeaseAmortization {
  id          String        @id @default(cuid())
  leaseId     String
  lease       LeaseContract @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  period      DateTime
  payment     Float
  interest    Float
  principal   Float
  balance     Float

  @@unique([leaseId, period])
  @@index([leaseId])
}

// ─── Deferred Tax ─────────────────────────────────────────────────────────────

model DeferredTaxItem {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  type           String   @default("ASSET")
  description    String?
  bookValue      Float
  taxValue       Float
  temporaryDiff  Float
  taxRate        Float    @default(0.21)
  deferredAmount Float
  period         DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

// ─── Custom Reports ───────────────────────────────────────────────────────────

model CustomReport {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  reportType  String   @default("TABLE")
  configJson  String
  isPublic    Boolean  @default(false)
  lastRunAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

// ─── Financial Ratios ─────────────────────────────────────────────────────────

model FinancialSnapshot {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  period           DateTime
  currentRatio     Float?
  quickRatio       Float?
  cashRatio        Float?
  grossMargin      Float?
  netMargin        Float?
  returnOnAssets   Float?
  returnOnEquity   Float?
  debtToEquity     Float?
  debtRatio        Float?
  interestCoverage Float?
  assetTurnover    Float?
  inventoryTurnover Float?
  receivablesDays  Float?
  payablesDays     Float?
  createdAt        DateTime @default(now())

  @@unique([userId, period])
  @@index([userId])
}

// ─── Segregation of Duties Rules ─────────────────────────────────────────────

model SodRule {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  action1      String
  action2      String
  conflictType String   @default("SEPARATION_REQUIRED")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([userId])
}

model SodViolation {
  id         String   @id @default(cuid())
  userId     String
  ruleId     String
  actorId    String
  action     String
  entityId   String
  detectedAt DateTime @default(now())
  resolved   Boolean  @default(false)
  notes      String?

  @@index([userId])
}

// ─── Integration Configs ──────────────────────────────────────────────────────

model IntegrationConfig {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider    String
  status      String   @default("INACTIVE")
  credentials String?
  lastSyncAt  DateTime?
  config      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, provider])
  @@index([userId])
}

// ─── Vendor Portal ────────────────────────────────────────────────────────────

model VendorPortalInvite {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendorName  String
  vendorEmail String
  token       String   @unique
  status      String   @default("PENDING")
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  submissions VendorBillSubmission[]

  @@index([userId])
}

model VendorBillSubmission {
  id              String             @id @default(cuid())
  inviteId        String
  invite          VendorPortalInvite @relation(fields: [inviteId], references: [id])
  vendorName      String
  amount          Float
  currency        String             @default("USD")
  dueDate         DateTime
  description     String
  attachmentData  String?
  status          String             @default("SUBMITTED")
  convertedBillId String?
  createdAt       DateTime           @default(now())

  @@index([inviteId])
}

// ─── AI Anomaly Detection ─────────────────────────────────────────────────────

model AnomalyFlag {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactionId String?
  entityType    String
  entityId      String
  reason        String
  severity      String   @default("MEDIUM")
  riskScore     Float    @default(0)
  dismissed     Boolean  @default(false)
  resolvedAt    DateTime?
  createdAt     DateTime @default(now())

  @@index([userId])
}

// ─── Cash Flow Scenarios ──────────────────────────────────────────────────────

model CashFlowScenario {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  assumptions  String
  forecastJson String
  baselineId   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

// ─── White-label Config ───────────────────────────────────────────────────────

model WhiteLabelConfig {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandName     String?
  brandLogo     String?
  primaryColor  String   @default("#0f172a")
  accentColor   String   @default("#3b82f6")
  customDomain  String?
  supportEmail  String?
  footerText    String?
  hideVercel    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── Service Pipeline ─────────────────────────────────────────────────────────

model Statement {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  filename    String
  periodStart DateTime?
  periodEnd   DateTime?
  rowCount    Int       @default(0)
  status      String    @default("PROCESSING")
  errorMsg    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
}

// ─── Fund Transfer ────────────────────────────────────────────────────────────

model FundTransfer {
  id               String      @id @default(cuid())
  userId           String
  fromAccountId    String
  fromAccount      BankAccount @relation("FundTransferFrom", fields: [fromAccountId], references: [id])
  toAccountId      String
  toAccount        BankAccount @relation("FundTransferTo", fields: [toAccountId], references: [id])
  amount           Float
  date             DateTime
  description      String?
  reference        String?
  createdAt        DateTime    @default(now())

  @@index([userId])
}
