generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String?
  role      String   @default("CLIENT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts          Account[]
  sessions          Session[]
  transactions      Transaction[]
  reports           Report[]
  subscription      Subscription?
  bankAccounts      BankAccount[]
  invoices          Invoice[]
  budgets           Budget[]
  messages          Message[]
  auditLogs         AuditLog[]
  plaidConnections  PlaidConnection[]
  cashFlowForecasts CashFlowForecast[]
  paymentLink       String?
  customCategories  String?
  clients           Client[]
  companyName       String?
  companyAddress    String?
  companyLogo       String?
  revenueGoal       Float?
  documents         Document[]
  vatNumber         String?

  chartOfAccounts      ChartOfAccount[]
  journalEntries       JournalEntry[]
  bills                Bill[]
  lockedPeriods        LockedPeriod[]
  fixedAssets          FixedAsset[]
  payrollRuns          PayrollRun[]
  timeEntries          TimeEntry[]
  workpapers           Workpaper[]
  vatReturns           VatReturn[]
  managedClients       ManagedClient[]      @relation("accountant")
  managedByAccounts    ManagedClient[]      @relation("client")
  emailVerified        Boolean              @default(false)
  emailVerifications   EmailVerification[]
  passwordResetTokens  PasswordResetToken[]
}

model EmailVerification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Transaction {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date             DateTime
  description      String
  amount           Float
  type             String
  category         String?
  subcategory      String?
  confidence       Float?
  status           String   @default("PENDING")
  aiNotes          String?
  reportId         String?
  report           Report?  @relation(fields: [reportId], references: [id])
  createdAt        DateTime @default(now())

  bankAccountId    String?
  bankAccount      BankAccount? @relation(fields: [bankAccountId], references: [id])
  receiptData      String?
  receiptOcrRaw    String?
  taxCategory      String?
  taxLine          String?
  isRecurring      Boolean  @default(false)
  recurringGroupId String?
  reconciled       Boolean  @default(false)
  reconciledAt     DateTime?
  bankStatementRef String?
  invoiceId        String?
  invoice          Invoice? @relation(fields: [invoiceId], references: [id])
  notes            String?

  messages            Message[]
  auditLogs           AuditLog[]
  reconciliationItems ReconciliationItem[]
}

model Report {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  month         Int
  year          Int
  status        String        @default("DRAFT")
  totalIncome   Float         @default(0)
  totalExpenses Float         @default(0)
  netProfit     Float         @default(0)
  aiSummary     String?
  sentAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  transactions  Transaction[]
  messages      Message[]
  workpapers    Workpaper[]

  clientApprovalToken String?  @unique
  clientApprovedAt    DateTime?
  clientEmail         String?
}

model Subscription {
  id        String    @id @default(cuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      String    @default("STARTER")
  status    String    @default("ACTIVE")
  stripeId  String?
  startedAt DateTime  @default(now())
  expiresAt DateTime?
}

model BankAccount {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  accountType     String   @default("CHECKING")
  institutionName String?
  lastFourDigits  String?
  currency        String   @default("USD")
  currentBalance  Float    @default(0)
  isPlaidLinked   Boolean  @default(false)
  plaidAccountId  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  transactions    Transaction[]
  reconciliations Reconciliation[]
}

model Reconciliation {
  id               String   @id @default(cuid())
  bankAccountId    String
  bankAccount      BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  userId           String
  statementDate    DateTime
  statementBalance Float
  status           String   @default("IN_PROGRESS")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  items ReconciliationItem[]
}

model ReconciliationItem {
  id               String         @id @default(cuid())
  reconciliationId String
  reconciliation   Reconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  transactionId    String?
  transaction      Transaction?   @relation(fields: [transactionId], references: [id])
  statementDate    DateTime
  statementDesc    String
  statementAmount  Float
  matched          Boolean  @default(false)
  matchedAt        DateTime?
  createdAt        DateTime @default(now())
}

model Invoice {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoiceNumber String
  clientName    String
  clientEmail   String?
  clientVatNumber String?
  issueDate     DateTime
  dueDate       DateTime
  status        String   @default("DRAFT")
  subtotal      Float
  taxRate       Float    @default(0)
  taxAmount     Float    @default(0)
  total         Float
  notes         String?
  paidAt        DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  lineItems    InvoiceLineItem[]
  transactions Transaction[]

  clientId          String?
  client            Client?  @relation(fields: [clientId], references: [id])
  isRecurring       Boolean  @default(false)
  recurringInterval String?
  nextInvoiceDate   DateTime?
  publicToken       String?   @unique
  amountPaid        Float     @default(0)
  type              String   @default("INVOICE")
  currency          String   @default("USD")
  lateFeePct        Float    @default(0)
  timeEntries       TimeEntry[]

  @@unique([userId, invoiceNumber])
}

model Client {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  phone     String?
  company   String?
  address   String?
  notes     String?
  vatNumber String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  invoices  Invoice[]
  documents Document[]
  timeEntries TimeEntry[]

  @@index([userId])
}

model InvoiceLineItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Float   @default(1)
  unitPrice   Float
  amount      Float
  createdAt   DateTime @default(now())
}

model Budget {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month     Int
  year      Int
  category  String
  amount    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, year, month, category])
}

model Message {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id])
  reportId      String?
  report        Report?      @relation(fields: [reportId], references: [id])
  body          String
  role          String       @default("CLIENT")
  readAt        DateTime?
  createdAt     DateTime     @default(now())
}

model AuditLog {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  action        String
  entityType    String
  entityId      String
  before        String?
  after         String?
  ipAddress     String?
  createdAt     DateTime     @default(now())
  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id])
}

model PlaidConnection {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  institutionId   String
  institutionName String
  accessToken     String
  itemId          String
  status          String    @default("ACTIVE")
  lastSyncAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model CashFlowForecast {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  generatedAt  DateTime @default(now())
  periodStart  DateTime
  periodEnd    DateTime
  forecastJson String
  narrative    String?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Document {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  type        String   @default("OTHER")
  content     String?
  mimeType    String   @default("text/plain")
  clientId    String?
  client      Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  status      String   @default("DRAFT")
  publicToken String?  @unique
  sentAt      DateTime?
  signedAt    DateTime?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([clientId])
}

// ─── Chart of Accounts ────────────────────────────────────────────────────────

model ChartOfAccount {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code          String
  name          String
  type          String   // ASSET | LIABILITY | EQUITY | REVENUE | EXPENSE
  subtype       String?
  description   String?
  parentCode    String?
  normalBalance String   @default("DEBIT")
  isSystem      Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  journalLines  JournalEntryLine[]

  @@unique([userId, code])
  @@index([userId])
}

// ─── Journal Entries ──────────────────────────────────────────────────────────

model JournalEntry {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entryNumber String
  date        DateTime
  description String
  reference   String?
  type        String   @default("MANUAL")
  status      String   @default("POSTED")
  reversalOf  String?
  memo        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lines       JournalEntryLine[]

  @@unique([userId, entryNumber])
  @@index([userId])
  @@index([userId, date])
}

model JournalEntryLine {
  id             String         @id @default(cuid())
  journalEntryId String
  journalEntry   JournalEntry   @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        ChartOfAccount @relation(fields: [accountId], references: [id])
  description    String?
  debit          Float          @default(0)
  credit         Float          @default(0)
  createdAt      DateTime       @default(now())

  @@index([journalEntryId])
  @@index([accountId])
}

// ─── Accounts Payable ─────────────────────────────────────────────────────────

model Bill {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  billNumber  String
  vendorName  String
  vendorEmail String?
  issueDate   DateTime
  dueDate     DateTime
  status      String   @default("PENDING")
  subtotal    Float
  taxRate     Float    @default(0)
  taxAmount   Float    @default(0)
  total       Float
  amountPaid  Float    @default(0)
  currency    String   @default("USD")
  notes       String?
  category    String?
  paidAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lineItems   BillLineItem[]

  @@unique([userId, billNumber])
  @@index([userId])
}

model BillLineItem {
  id          String   @id @default(cuid())
  billId      String
  bill        Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  description String
  quantity    Float    @default(1)
  unitPrice   Float
  amount      Float
  accountCode String?
  createdAt   DateTime @default(now())
}

// ─── Period Locking ───────────────────────────────────────────────────────────

model LockedPeriod {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  year     Int
  month    Int
  lockedAt DateTime @default(now())
  lockedBy String
  notes    String?

  @@unique([userId, year, month])
  @@index([userId])
}

// ─── Fixed Assets ─────────────────────────────────────────────────────────────

model FixedAsset {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  assetNumber        String?
  description        String?
  purchaseDate       DateTime
  purchaseCost       Float
  salvageValue       Float    @default(0)
  usefulLifeMonths   Int
  depreciationMethod String   @default("STRAIGHT_LINE")
  assetAccountCode   String?
  depnAccountCode    String?
  expenseAccountCode String?
  disposalDate       DateTime?
  disposalValue      Float?
  status             String   @default("ACTIVE")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  depreciationEntries DepreciationEntry[]

  @@index([userId])
}

model DepreciationEntry {
  id        String     @id @default(cuid())
  assetId   String
  asset     FixedAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  userId    String
  month     Int
  year      Int
  amount    Float
  bookValue Float
  posted    Boolean    @default(false)
  createdAt DateTime   @default(now())

  @@unique([assetId, year, month])
  @@index([userId])
}

// ─── Payroll ──────────────────────────────────────────────────────────────────

model PayrollRun {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  runNumber   String
  periodStart DateTime
  periodEnd   DateTime
  payDate     DateTime
  totalGross  Float    @default(0)
  totalTax    Float    @default(0)
  totalNet    Float    @default(0)
  status      String   @default("DRAFT")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees   PayrollEmployee[]

  @@index([userId])
}

model PayrollEmployee {
  id              String     @id @default(cuid())
  payrollRunId    String
  payrollRun      PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  userId          String
  employeeName    String
  employeeId      String?
  payType         String     @default("SALARY")
  hoursWorked     Float?
  hourlyRate      Float?
  grossPay        Float
  federalTax      Float      @default(0)
  stateTax        Float      @default(0)
  socialSecurity  Float      @default(0)
  medicare        Float      @default(0)
  otherDeductions Float      @default(0)
  netPay          Float
  is1099          Boolean    @default(false)
  createdAt       DateTime   @default(now())
}

// ─── Time Tracking ────────────────────────────────────────────────────────────

model TimeEntry {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId    String?
  client      Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  date        DateTime
  hours       Float
  description String
  hourlyRate  Float    @default(0)
  amount      Float    @default(0)
  billable    Boolean  @default(true)
  invoiced    Boolean  @default(false)
  invoiceId   String?
  invoice     Invoice? @relation(fields: [invoiceId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([clientId])
}

// ─── Workpapers ───────────────────────────────────────────────────────────────

model Workpaper {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reportId    String?
  report      Report?  @relation(fields: [reportId], references: [id])
  name        String
  description String?
  status      String   @default("IN_PROGRESS")
  assignedTo  String?
  dueDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       WorkpaperItem[]

  @@index([userId])
}

model WorkpaperItem {
  id          String    @id @default(cuid())
  workpaperId String
  workpaper   Workpaper @relation(fields: [workpaperId], references: [id], onDelete: Cascade)
  description String
  reference   String?
  status      String    @default("PENDING")
  notes       String?
  tickedBy    String?
  tickedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ─── VAT Returns ──────────────────────────────────────────────────────────────

model VatReturn {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  periodStart    DateTime
  periodEnd      DateTime
  totalSales     Float    @default(0)
  vatOnSales     Float    @default(0)
  totalPurchases Float    @default(0)
  vatOnPurchases Float    @default(0)
  vatPayable     Float    @default(0)
  status         String   @default("DRAFT")
  filedAt        DateTime?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

// ─── Multi-client Mode ────────────────────────────────────────────────────────

model ManagedClient {
  id           String   @id @default(cuid())
  accountantId String
  accountant   User     @relation("accountant", fields: [accountantId], references: [id], onDelete: Cascade)
  clientId     String
  client       User     @relation("client", fields: [clientId], references: [id], onDelete: Cascade)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@unique([accountantId, clientId])
  @@index([accountantId])
}
